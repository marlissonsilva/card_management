generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  uuid            String   @id @default(cuid())
  email           String   @unique
  name            String?
  invoice_closing Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  members Member[]

  @@map("user")
}

model Member {
  uuid       String   @id @default(cuid())
  name       String
  user_uuid  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)

  @@unique([user_uuid, uuid], map: "unique_member_per_user")
  @@index([user_uuid], map: "idx_members_user")
  @@map("member")
}

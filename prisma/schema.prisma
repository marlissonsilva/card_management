generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  uuid            String   @id @default(cuid())
  email           String   @unique
  username        String
  password        String
  invoice_closing Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  members Member[]

  @@map("user")
}

model Member {
  uuid       String   @id @default(cuid())
  name       String
  user_uuid  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user      User       @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade)
  purchases Purchase[]

  @@unique([user_uuid, name], map: "unique_member_per_user")
  @@index([user_uuid], map: "idx_members_user")
  @@map("member")
}

model Purchase {
  uuid               String   @id @default(cuid())
  description        String?
  amount             Int
  status             String   @default("OPEN")
  date_purchase      DateTime
  installments_count Int      @default(1)
  member_uuid        String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  member      Member        @relation(fields: [member_uuid], references: [uuid], onDelete: Cascade)
  installment Installment[]

  @@index([member_uuid], map: "idx_purchases_member")
  @@map("purchase")
}

model Installment {
  uuid               String   @id @default(cuid())
  purchase_uuid      String
  installment_number Int
  value              Int
  due_date           DateTime @db.Date
  is_paid            Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  purchase Purchase @relation(fields: [purchase_uuid], references: [uuid], onDelete: Cascade)

  @@unique([purchase_uuid, installment_number], map: "unique_installment_number")
  @@index([purchase_uuid], map: "idx_installments_purchase")
  @@index([due_date], map: "idx_installments_due_date")
  @@map("installment")
}

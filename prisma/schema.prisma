generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  uuid            String   @id @default(cuid())
  email           String   @unique
  name            String?
  invoice_closing Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user")
}
